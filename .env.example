# Copie para .env (nunca vai para o git) e preencha. Usado por compose.prod.yaml.

# Endereco publico do app, sem https:// (ex.: treino.duckdns.org). O DNS tem de apontar para a VM.
DOMINIO=

# Senha do Postgres (gere uma: openssl rand -base64 24)
POSTGRES_PASSWORD=

# Chave do access token, 32+ caracteres (gere uma: openssl rand -base64 48)
TRAININGAPP_AUTH_JWT_SEGREDO=

# E-mails que podem entrar, separados por virgula
TRAININGAPP_AUTH_EMAILS_PERMITIDOS=

# Login com Google (vazio = sem o botao). Cadastre https://<DOMINIO> nas origens do client id.
TRAININGAPP_AUTH_GOOGLE_CLIENT_ID=
TRAININGAPP_AUTH_GOOGLE_CLIENT_SECRET=

# SMTP (exemplo Gmail com senha de app). Para nao enviar e-mail, apague as quatro linhas SPRING_MAIL_*.
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
TRAININGAPP_EMAIL_REMETENTE=TrainingApp <voce@gmail.com>
